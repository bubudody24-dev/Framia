{
  "name": "framia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun run build:worker",
    "build:worker": "esbuild worker.js --bundle --format=esm --platform=browser --target=es2022 --outfile=dist-worker/worker.js",
    "preview": "vite preview",
    "build:wasm": "cargo build --release --manifest-path wasm/fill/Cargo.toml --target wasm32-unknown-unknown && cp wasm/fill/target/wasm32-unknown-unknown/release/framia_fill.wasm public/wasm/fill.wasm"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "vite": "6.3.5",
    "wrangler": "4.148.0"
  },
  "dependencies": {
    "@freebuff/auth": "^0.1.0"
  }
}
